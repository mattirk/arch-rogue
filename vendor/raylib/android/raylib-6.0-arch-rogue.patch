+// Arch Rogue's NativeActivity bridge. These process-local facts deliberately
+// stay outside raylib's public API; the vendored Odin binding exposes them only
+// for Android builds. Lifecycle callbacks share the native game thread; Android's
+// Java back callback arrives on the UI thread and uses atomic compiler builtins.
+enum {
+    ARCH_ROGUE_ANDROID_EVENT_START = 1u << 0,
+    ARCH_ROGUE_ANDROID_EVENT_RESUME = 1u << 1,
+    ARCH_ROGUE_ANDROID_EVENT_INIT_WINDOW = 1u << 2,
+    ARCH_ROGUE_ANDROID_EVENT_GAINED_FOCUS = 1u << 3,
+    ARCH_ROGUE_ANDROID_EVENT_PAUSE = 1u << 4,
+    ARCH_ROGUE_ANDROID_EVENT_LOST_FOCUS = 1u << 5,
+    ARCH_ROGUE_ANDROID_EVENT_TERM_WINDOW = 1u << 6,
+    ARCH_ROGUE_ANDROID_EVENT_STOP = 1u << 7,
+    ARCH_ROGUE_ANDROID_EVENT_DESTROY = 1u << 8,
+    ARCH_ROGUE_ANDROID_EVENT_LOW_MEMORY = 1u << 9,
+    ARCH_ROGUE_ANDROID_EVENT_CONFIG_CHANGED = 1u << 10,
+    ARCH_ROGUE_ANDROID_EVENT_CONTENT_RECT_CHANGED = 1u << 11
+};
+
+static unsigned int archRogueLifecycleEvents = 0;
+static unsigned int archRogueBackPresses = 0;
+
+JNIEXPORT void JNICALL Java_org_archrogue_archrogue_odin_ArchRogueActivity_nativeOnBackPressed(
+    JNIEnv *env, jclass activityClass)
+{
+    (void)env;
+    (void)activityClass;
+    __atomic_fetch_add(&archRogueBackPresses, 1u, __ATOMIC_RELEASE);
+}
+
+__attribute__((visibility("default"))) unsigned int ArchRogueAndroidDrainBackPresses(void)
+{
+    return __atomic_exchange_n(&archRogueBackPresses, 0u, __ATOMIC_ACQ_REL);
+}
+
+__attribute__((visibility("default"))) unsigned int ArchRogueAndroidDrainLifecycleEvents(void)
+{
+    unsigned int events = archRogueLifecycleEvents;
+    archRogueLifecycleEvents = 0;
+    return events;
+}
+
+__attribute__((visibility("default"))) const char *ArchRogueAndroidInternalDataPath(void)
+{
+    if ((platform.app == NULL) || (platform.app->activity == NULL)) return NULL;
+    return platform.app->activity->internalDataPath;
+}
+
+__attribute__((visibility("default"))) int ArchRogueAndroidGetSafeInsets(int *left, int *top, int *right, int *bottom)
+{
+    if ((left == NULL) || (top == NULL) || (right == NULL) || (bottom == NULL) ||
+        (platform.app == NULL) || (platform.app->window == NULL)) return 0;
+
+    int width = ANativeWindow_getWidth(platform.app->window);
+    int height = ANativeWindow_getHeight(platform.app->window);
+    ARect rect = platform.app->contentRect;
+    if ((rect.right <= rect.left) || (rect.bottom <= rect.top))
+    {
+        rect.left = 0;
+        rect.top = 0;
+        rect.right = width;
+        rect.bottom = height;
+    }
+
+    *left = (rect.left > 0)? rect.left : 0;
+    *top = (rect.top > 0)? rect.top : 0;
+    *right = (width > rect.right)? width - rect.right : 0;
+    *bottom = (height > rect.bottom)? height - rect.bottom : 0;
+    return 1;
+}
+
+__attribute__((visibility("default"))) int ArchRogueAndroidIsInteractive(void)
+{
+    return (platform.app != NULL) && platform.appEnabled &&
+        (platform.app->window != NULL) && (platform.surface != EGL_NO_SURFACE);
+}
+
+__attribute__((visibility("default"))) int ArchRogueAndroidApiLevel(void)
+{
+    return android_get_device_api_level();
+}
+
+__attribute__((visibility("default"))) void ArchRogueAndroidLog(const char *message)
+{
+    if (message != NULL) __android_log_write(ANDROID_LOG_INFO, "ArchRogue", message);
+}
