	.Arcanist_Ward = {"Ward", .Arcanist},
	.Acolyte_Blood = {"Blood", .Acolyte},
	.Acolyte_Veil = {"Veil", .Acolyte},
	.Acolyte_Spirit = {"Spirit", .Acolyte},
	.Acolyte_Curse = {"Curse", .Acolyte},
	.Ranger_Control = {"Control", .Ranger},
	.Ranger_Volley = {"Volley", .Ranger},
	.Ranger_Beast = {"Beast", .Ranger},
	.Ranger_Survival = {"Survival", .Ranger},
}

@(rodata)
DISCIPLINE_PATH_LAYOUT := [Archetype_Id][DISCIPLINE_PATHS_PER_ARCHETYPE]Discipline_Path{
	.Warden = {.Warden_Bulwark, .Warden_Riposte, .Warden_Vow, .Warden_Time},
	.Rogue = {.Rogue_Precision, .Rogue_Shadow, .Rogue_Traps, .Rogue_Marksman},
	.Arcanist = {.Arcanist_Bolt, .Arcanist_Nova, .Arcanist_Storm, .Arcanist_Ward},
	.Acolyte = {.Acolyte_Blood, .Acolyte_Veil, .Acolyte_Spirit, .Acolyte_Curse},
	.Ranger = {.Ranger_Control, .Ranger_Volley, .Ranger_Beast, .Ranger_Survival},
}

