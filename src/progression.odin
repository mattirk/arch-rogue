Discipline_Path :: enum u8 {
	Warden_Bulwark,
	Warden_Riposte,
	Warden_Vow,
	Warden_Time,
	Rogue_Precision,
	Rogue_Shadow,
	Rogue_Traps,
	Rogue_Marksman,
	Arcanist_Bolt,
	Arcanist_Nova,
	Arcanist_Storm,
	Arcanist_Ward,
	Acolyte_Blood,
	Acolyte_Veil,
	Acolyte_Spirit,
	Acolyte_Curse,
	Ranger_Control,
	Ranger_Volley,
	Ranger_Beast,
	Ranger_Survival,
}

Discipline_Tag :: enum u8 {
	None,
	Aim,
	Arcane,
	Beast,
	Blood,
	Control,
	Counter,
	Critical,
	Curse,
	Frost,
	Guard,
	Holy,
	Shield,
	Spirit,
	Stealth,
	Storm,
	Survival,
	Time,
	Trap,
	Veil,
	Volley,
}

// Untracked is intentionally the zero value. Table validation fails if a new
// node is added without declaring how much of its bespoke behavior is ported.
// Fully_Wired marks nodes whose player-facing text is completely represented
// at runtime (MX.3); Stats_Only remains for nodes that only promise stats.
Discipline_Effect_Coverage :: enum u8 {
	Untracked,
	Stats_Only,
	Partially_Wired,
	Deferred,
	Fully_Wired,
}

Discipline_Def :: struct {
	key:                      string,
	name:                     string,
	description:              string,
	archetype:                Archetype_Id,
	path:                     Discipline_Path,
	degree:                   u8,
	has_prerequisite:         bool,
	prerequisite:             Discipline_Id,
	melee_bonus:              int,
	spell_bonus:              int,
	armor_bonus:              int,
	max_hp_bonus:             int,
	max_mana_bonus:           int,
	max_stamina_bonus:        int,
	speed_bonus:              f32,
	tag:                      Discipline_Tag,
	cross_path_tag:           Discipline_Tag,
	cross_path_bonus_melee:   int,
	cross_path_bonus_spell:   int,
	effect_coverage:          Discipline_Effect_Coverage,
}

Discipline_Stat_Kind :: enum u8 {
	Health,
	Mana,
	Stamina,
	Melee,
	Spell,
	Armor,
	Move_Speed,
}

DISCIPLINE_STAT_BONUS_CAPACITY :: len(Discipline_Stat_Kind)

// Amount is the player-facing value: flat points for pools/combat stats and
// percentage points for movement. Movement's authored rating is converted by
// the same 25% factor used by player_speed.
Discipline_Stat_Bonus :: struct {
	kind:   Discipline_Stat_Kind,
	amount: f32,
}

Discipline_Mechanic_Kind :: enum u8 {
	None,
	Melee,
	Defense,
	Mobility,
	Spell,
	Control,
	Summon,
	Resource,
}

Discipline_Mechanic_Summary :: struct {
	kind: Discipline_Mechanic_Kind,
	text: string,
}

Discipline_Path_Def :: struct {
	name:      string,
	archetype: Archetype_Id,
}

@(rodata)
DISCIPLINE_PATH_DEFS := [Discipline_Path]Discipline_Path_Def{
	.Warden_Bulwark = {"Bulwark", .Warden},
	.Warden_Riposte = {"Riposte", .Warden},
	.Warden_Vow = {"Vow", .Warden},
	.Warden_Time = {"Time", .Warden},
	.Rogue_Precision = {"Precision", .Rogue},
