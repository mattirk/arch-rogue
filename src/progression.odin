package archrogue

// Character progression data and rules. This file is deliberately raylib-free:
// the character sheet and future save layer consume the same stable IDs and
// pure acquisition helpers as headless simulation tests.
// Definitions are a field-for-field port of
// src/arch_rogue/content/progression.py::DISCIPLINES (100 nodes).

MAX_COMMITTED_DISCIPLINE_PATHS :: 2
DISCIPLINE_COUNT :: 100
DISCIPLINE_DEGREES :: 5
DISCIPLINE_PATHS_PER_ARCHETYPE :: 4

