discipline_stat_bonuses :: proc(def: Discipline_Def) -> (
	bonuses: [DISCIPLINE_STAT_BONUS_CAPACITY]Discipline_Stat_Bonus,
	count: int,
) {
	if def.max_hp_bonus != 0 {
		bonuses[count] = {.Health, f32(def.max_hp_bonus)}
		count += 1
	}
	if def.max_mana_bonus != 0 {
		bonuses[count] = {.Mana, f32(def.max_mana_bonus)}
		count += 1
	}
	if def.max_stamina_bonus != 0 {
		bonuses[count] = {.Stamina, f32(def.max_stamina_bonus)}
		count += 1
	}
	if def.melee_bonus != 0 {
		bonuses[count] = {.Melee, f32(def.melee_bonus)}
		count += 1
	}
	if def.spell_bonus != 0 {
		bonuses[count] = {.Spell, f32(def.spell_bonus)}
		count += 1
	}
	if def.armor_bonus != 0 {
		bonuses[count] = {.Armor, f32(def.armor_bonus)}
		count += 1
	}
	if def.speed_bonus != 0 {
		bonuses[count] = {.Move_Speed, def.speed_bonus * 25}
		count += 1
	}
	return
}

Discipline_State :: enum u8 {
	Chosen,
	Available,
	Path_Locked,
	Locked,
}

Discipline_Acquire_Result :: enum u8 {
	Acquired,
	Wrong_Archetype,
	Already_Chosen,
	Prerequisite_Locked,
	Path_Locked,
	No_Tokens,
}

Discipline_Combo_Bonus :: struct {
	melee:  int,
	spell:  int,
	max_hp: int,
}

Discipline_Cross_Path_Bonus :: struct {
	melee: int,
	spell: int,
}

discipline_def :: proc(id: Discipline_Id) -> Discipline_Def {
	return DISCIPLINES[id]
}

discipline_by_key :: proc(key: string) -> (Discipline_Id, bool) {
	for id in Discipline_Id {
		if DISCIPLINES[id].key == key do return id, true
	}
	return {}, false
}

discipline_path_at :: proc(archetype: Archetype_Id, column: int) -> (Discipline_Path, bool) {
	if column < 0 || column >= DISCIPLINE_PATHS_PER_ARCHETYPE do return {}, false
	return DISCIPLINE_PATH_LAYOUT[archetype][column], true
}

discipline_at :: proc(path: Discipline_Path, degree: int) -> (Discipline_Id, bool) {
	if degree < 1 || degree > DISCIPLINE_DEGREES do return {}, false
	for id in Discipline_Id {
		def := DISCIPLINES[id]
		if def.path == path && int(def.degree) == degree do return id, true
	}
	return {}, false
}

discipline_path_rank :: proc(player: ^Player, path: Discipline_Path) -> int {
	if player == nil do return 0
	rank := 0
	for id in Discipline_Id {
		if player.acquired_disciplines[id] && DISCIPLINES[id].path == path do rank += 1
	}
	return rank
}

discipline_path_committed :: proc(player: ^Player, path: Discipline_Path) -> bool {
	return discipline_path_rank(player, path) > 0
}

discipline_committed_path_count :: proc(player: ^Player) -> int {
	if player == nil do return 0
	count := 0
	for path in DISCIPLINE_PATH_LAYOUT[player.archetype] {
		if discipline_path_committed(player, path) do count += 1
	}
	return count
}

discipline_path_locked :: proc(player: ^Player, path: Discipline_Path) -> bool {
	if player == nil do return true
	if discipline_path_committed(player, path) do return false
	return discipline_committed_path_count(player) >= MAX_COMMITTED_DISCIPLINE_PATHS
}

discipline_completed_path_count :: proc(player: ^Player) -> int {
	if player == nil do return 0
	count := 0
	for path in DISCIPLINE_PATH_LAYOUT[player.archetype] {
		if discipline_path_rank(player, path) == DISCIPLINE_DEGREES do count += 1
	}
	return count
}

discipline_combo_bonus :: proc(player: ^Player) -> Discipline_Combo_Bonus {
	completed := discipline_completed_path_count(player)
	if completed <= 0 do return {}
	steps := max(0, completed - 1)
	return {
		melee = completed + steps * 2,
		spell = completed + steps * 2,
		max_hp = completed * 6 + steps * 8,
	}
}

discipline_cross_path_bonus :: proc(player: ^Player) -> Discipline_Cross_Path_Bonus {
	result: Discipline_Cross_Path_Bonus
	if player == nil do return result
	for modifier_id in Discipline_Id {
		modifier := DISCIPLINES[modifier_id]
		if !player.acquired_disciplines[modifier_id] || modifier.cross_path_tag == .None do continue
		for target_id in Discipline_Id {
			target := DISCIPLINES[target_id]
			if player.acquired_disciplines[target_id] && target.tag == modifier.cross_path_tag {
				result.melee += modifier.cross_path_bonus_melee
				result.spell += modifier.cross_path_bonus_spell
			}
		}
	}
	return result
}

discipline_state :: proc(player: ^Player, id: Discipline_Id) -> Discipline_State {
	if player == nil do return .Locked
	def := DISCIPLINES[id]
	if player.acquired_disciplines[id] do return .Chosen
	if def.archetype != player.archetype do return .Locked
	if discipline_path_locked(player, def.path) do return .Path_Locked
	if def.has_prerequisite && !player.acquired_disciplines[def.prerequisite] do return .Locked
	return .Available
}

grant_memory_tokens :: proc(player: ^Player, amount := 1) {
	if player == nil || amount <= 0 do return
	player.memory_tokens += amount
}

discipline_try_acquire :: proc(player: ^Player, id: Discipline_Id) -> Discipline_Acquire_Result {
	if player == nil do return .Wrong_Archetype
	def := DISCIPLINES[id]
	if def.archetype != player.archetype do return .Wrong_Archetype
	if player.acquired_disciplines[id] do return .Already_Chosen
	if def.has_prerequisite && !player.acquired_disciplines[def.prerequisite] do return .Prerequisite_Locked
	if discipline_path_locked(player, def.path) do return .Path_Locked
	if player.memory_tokens <= 0 do return .No_Tokens

	// Every rejection above is mutation-free. From here on acquisition cannot
	// fail, so spending the token and applying its bonuses is one atomic action.
	player.memory_tokens -= 1
	player.acquired_disciplines[id] = true
	player.discipline_melee_bonus += def.melee_bonus
	player.discipline_spell_bonus += def.spell_bonus
	player.discipline_armor_bonus += def.armor_bonus
	player.discipline_speed_bonus += def.speed_bonus
	player.max_hp += def.max_hp_bonus
	player.hp = min(player.max_hp, player.hp + def.max_hp_bonus)
	player.max_mana += def.max_mana_bonus
	player.mana = min(f32(player.max_mana), player.mana + f32(def.max_mana_bonus))
	player.max_stamina += def.max_stamina_bonus
	player.stamina = min(f32(player.max_stamina), player.stamina + f32(def.max_stamina_bonus))

	combo := discipline_combo_bonus(player)
	delta_melee := combo.melee - player.discipline_combo_melee_applied
	delta_spell := combo.spell - player.discipline_combo_spell_applied
	delta_hp := combo.max_hp - player.discipline_combo_hp_applied
	player.discipline_melee_bonus += delta_melee
	player.discipline_spell_bonus += delta_spell
	player.max_hp += delta_hp
	player.hp = min(player.max_hp, player.hp + delta_hp)
	player.discipline_combo_melee_applied = combo.melee
	player.discipline_combo_spell_applied = combo.spell
	player.discipline_combo_hp_applied = combo.max_hp

	if def.path == .Rogue_Precision {
		player.precision_rank = u8(discipline_path_rank(player, .Rogue_Precision))
	}
	return .Acquired
}

// Runtime-facing acquisition adds the two canonical live-actor side effects:
// Beast nodes immediately refresh an already-summoned Spirit Beast, while
// Sanguine blood-binds already-summoned living Spirit Call Wisps and Crows.
// Character UI should call this wrapper; tests and save reconstruction can use
// discipline_try_acquire directly when only Player state exists.
run_try_acquire_discipline :: proc(run: ^Run, id: Discipline_Id) -> Discipline_Acquire_Result {
	if run == nil do return .Wrong_Archetype
	result := discipline_try_acquire(&run.player, id)
	if result == .Acquired {
		if DISCIPLINES[id].path == .Ranger_Beast {
			refresh_active_spirit_beast(run, discipline_path_rank(&run.player, .Ranger_Beast), player_has_skill_bonus(&run.player, .Spirit_Beast_Bond))
		} else if id == .Acolyte_Sanguine {
			for &familiar in run.familiars {
				if familiar.hp > 0 && (familiar.kind == .Wisp || familiar.kind == .Crow) {
					familiar.lifesteal = true
				}
			}
		}
	}
	return result
}

// Keep the direct rank field as an M8 test/save compatibility seam while live
// progression derives the canonical rank from acquired nodes.
player_precision_rank :: proc(player: ^Player) -> u8 {
	if player == nil do return 0
	return u8(max(int(player.precision_rank), discipline_path_rank(player, .Rogue_Precision)))
}

player_has_discipline :: proc(player: ^Player, id: Discipline_Id) -> bool {
	return player != nil && player.acquired_disciplines[id]
}

// Blood-path siphon ladders (combat/projectiles.py:406-438). Melee strikes
// siphon less than spells; both read live so a mid-run purchase deepens an
// already-summoned host's drain immediately.
acolyte_melee_leech :: proc(player: ^Player) -> int {
	switch {
	case player_has_discipline(player, .Acolyte_Sanguine_Ascendant): return 6
	case player_has_discipline(player, .Acolyte_Crimson_Maw): return 5
	case player_has_discipline(player, .Acolyte_Blood_Pact): return 4
	case player_has_discipline(player, .Acolyte_Gravebind): return 3
	case player_has_discipline(player, .Acolyte_Sanguine): return 2
	case player_has_skill_bonus(player, .Blood_Leech): return 1
	}
	return 0
}

acolyte_spell_leech :: proc(player: ^Player) -> int {
	switch {
	case player_has_discipline(player, .Acolyte_Sanguine_Ascendant): return 8
	case player_has_discipline(player, .Acolyte_Crimson_Maw): return 7
	case player_has_discipline(player, .Acolyte_Blood_Pact): return 5
	case player_has_discipline(player, .Acolyte_Gravebind): return 4
	case player_has_discipline(player, .Acolyte_Sanguine): return 3
	case player_has_skill_bonus(player, .Blood_Leech): return 1
	}
	return 0
}
