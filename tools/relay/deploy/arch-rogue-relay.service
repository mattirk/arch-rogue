# Arch Rogue multiplayer relay (Odin) — systemd user unit template.
#
# .github/workflows/server-deploy.yml installs this unit into
# ~/.config/systemd/user/ on every deploy, writes ~/arch-rogue-relay/env from
# the PORT and ORIGINS variables of the GitHub Environment "ar-rita-kasari-fi",
# points ~/arch-rogue-relay/current at the newest release, and restarts it.
# The only manual host step is `sudo loginctl enable-linger <runner-user>`.
#
# The relay serves private plaintext WebSocket on loopback only; public TLS
# terminates at nginx (tools/relay/deploy/nginx-ar.rita-kasari.fi.conf).

[Unit]
Description=Arch Rogue multiplayer relay (Odin, private WS behind nginx)
After=network-online.target
Wants=network-online.target
# A broken release restarts a few times, then stays down for the deploy's
# health probe to notice and roll back, instead of thrashing.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/arch-rogue-relay/current
EnvironmentFile=%h/arch-rogue-relay/env
ExecStart=%h/arch-rogue-relay/current/archrogue_relay --bind 127.0.0.1 --port ${PORT} --origins ${ORIGINS} --max-rooms ${MAX_ROOMS}
Restart=on-failure
RestartSec=2
# Rooms and tokens are in-memory only; a stop drops in-flight rooms and the
# clients ride it out inside their 30 s reconnect grace.
TimeoutStopSec=10
# Hardening available to user units (security audit 2026-10-11, finding 5).
# The relay writes nothing: rooms and tokens are memory-only, so it gets no
# writable path at all, not even its own release directory.
#
# Deliberately absent, because the production host's user manager runs
# under a container manager that forbids dropping capabilities from the
# bounding set (every spawn fails with status 218/CAPABILITIES, observed
# 2026-10-11 and 2026-10-13): CapabilityBoundingSet=, and the directives that
# imply a capability drop, PrivateDevices= (CAP_MKNOD/CAP_SYS_RAWIO),
# ProtectKernelModules= (CAP_SYS_MODULE), ProtectKernelLogs= (CAP_SYSLOG),
# ProtectClock= (CAP_SYS_TIME/CAP_WAKE_ALARM). A user unit holds none of those
# capabilities anyway. ProtectHostname= is absent because UTS namespaces are
# prohibited there and it only logs a warning per start.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# lws sizes its fd table from --max-connections (default 512) + a margin.
LimitNOFILE=4096
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
